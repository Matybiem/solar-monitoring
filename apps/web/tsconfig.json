{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@solar/ui": ["../../packages/ui/src"],
      "@solar/design-tokens": ["../../packages/design-tokens/src"],
      "@solar/firebase-types": ["../../packages/firebase-types/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"]
}
