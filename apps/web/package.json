    "zod": "^3.23.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "lucide-react": "^0.427.0",
    "date-fns": "^3.6.0",
    "recharts": "^2.12.0",
    "firebase": "^10.13.0",
    "framer-motion": "^11.3.0"
